{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARC domain origin selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selected_paper_id",
    "selected_paper_title",
    "confidence",
    "reasoning",
    "candidate_assessments",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "arc.domain_origin_selection.v1"
    },
    "selected_paper_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:arXiv:(?:[0-9]{4}\\.[0-9]{4,5}|[A-Za-z][A-Za-z0-9.-]{0,63}/[0-9]{7})(?:v[0-9]+)?|doi:10\\.[0-9]{4,9}/[^\\s<>\"?#]+|inspire:[0-9]+)$",
      "description": "One exact ARC-resolvable identifier. The controller must normalize it and require membership in the supplied candidate IDs before using it."
    },
    "selected_paper_title": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "candidate_assessments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "title",
          "role",
          "citation_prior",
          "assessment"
        ],
        "properties": {
          "paper_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:arXiv:(?:[0-9]{4}\\.[0-9]{4,5}|[A-Za-z][A-Za-z0-9.-]{0,63}/[0-9]{7})(?:v[0-9]+)?|doi:10\\.[0-9]{4,9}/[^\\s<>\"?#]+|inspire:[0-9]+)$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "canonical_origin",
              "precursor",
              "broader_parent",
              "later_landmark",
              "unrelated"
            ]
          },
          "citation_prior": {
            "enum": [
              "below_100",
              "within_100_1000",
              "above_1000",
              "unknown"
            ]
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
