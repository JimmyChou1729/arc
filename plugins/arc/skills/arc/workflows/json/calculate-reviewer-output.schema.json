{
  "type": "object",
  "required": [
    "calculator_assessments",
    "review_reasoning",
    "trusted_results",
    "remarks",
    "workflow_action"
  ],
  "properties": {
    "calculator_assessments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["proposer_id", "assessment", "reason"],
        "properties": {
          "proposer_id": {"type": "string", "enum": []},
          "assessment": {
            "type": "string",
            "enum": ["valid", "invalid", "indeterminate"]
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review_reasoning": {"type": "string", "minLength": 1},
    "trusted_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary",
          "final_result",
          "derivation",
          "validity_scope",
          "supporting_proposer_ids",
          "selected_proposer_id",
          "comparison_reasoning"
        ],
        "properties": {
          "summary": {"type": "string", "minLength": 1},
          "final_result": {"type": "string", "minLength": 1},
          "derivation": {"type": "string", "minLength": 1},
          "validity_scope": {"type": "string", "minLength": 1},
          "supporting_proposer_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "enum": []}
          },
          "selected_proposer_id": {"type": "string", "enum": []},
          "comparison_reasoning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "remarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "summary", "reason", "related_proposer_ids"],
        "properties": {
          "status": {"type": "string", "const": "untrusted"},
          "summary": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "related_proposer_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "enum": []}
          }
        },
        "additionalProperties": false
      }
    },
    "workflow_action": {
      "type": "object",
      "required": ["action", "reason", "proposed_revision", "expert_question"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["continue", "retry", "replan", "pause_for_human"]
        },
        "reason": {"type": "string", "minLength": 1},
        "proposed_revision": {"type": ["string", "null"]},
        "expert_question": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"workflow_action": {"properties": {"action": {"type": "string", "const": "continue"}}}},
        "required": ["workflow_action"]
      },
      "then": {
        "properties": {"trusted_results": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {"workflow_action": {"properties": {"action": {"type": "string", "const": "retry"}}}},
        "required": ["workflow_action"]
      },
      "then": {
        "properties": {"trusted_results": {"maxItems": 0}}
      }
    },
    {
      "if": {
        "properties": {"workflow_action": {"properties": {"action": {"type": "string", "const": "replan"}}}},
        "required": ["workflow_action"]
      },
      "then": {
        "properties": {
          "workflow_action": {
            "properties": {
              "proposed_revision": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"workflow_action": {"properties": {"action": {"type": "string", "const": "pause_for_human"}}}},
        "required": ["workflow_action"]
      },
      "then": {
        "properties": {
          "workflow_action": {
            "properties": {
              "expert_question": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
